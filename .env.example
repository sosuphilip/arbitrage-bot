# Mode: "dry-run" (default, no orders placed) or "live" (real trades!)
MODE=dry-run

# Markets to scan (comma-separated)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# Min spread (in percent, net of fees) required to trade
MIN_SPREAD_PCT=0.5

# Max notional per trade, in quote currency (e.g. USDT)
MAX_TRADE_USD=10

# Quote currency to use
QUOTE=USDT

# Polling interval between scans (ms)
INTERVAL_MS=5000

# Telegram alerts (optional). Create a bot with @BotFather to get the token.
# Get your chat id with: npm run telegram-id  (after sending the bot a message)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
ALERT_SPREAD_PCT=0.2
ALERT_COOLDOWN_MS=600000

# Exchange API keys (row 1 = buy venue with the cheaper price, row 2 = sell venue)
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=
